# Alice - 环境变量配置示例
# 复制此文件为 .env 或 .env.local 进行修改
#
# 配置说明:
# - 环境变量优先级高于 config.yaml
# - 使用 CONFIG_ 前缀覆盖配置项
# - 支持嵌套配置，如 CONFIG_TURING_SERVER_PORT=9000
# =============================================================================

# =============================================================================
# 通用配置
# =============================================================================

# 调试模式 (true/false)
DEBUG=false

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# Alice 配置覆盖
# =============================================================================

# 启用 LTP 句法分析
CONFIG_ALICE_ENABLE_LTP=true

# 启用 NER 实体识别
CONFIG_ALICE_ENABLE_NER=true

# 启用对话日志
CONFIG_ALICE_ENABLE_LOG=true

# 启用热重载
CONFIG_ALICE_HOT_RELOAD=true

# 热重载模式 (auto/manual)
CONFIG_ALICE_HOT_RELOAD_MODE=auto

# 脚本文件路径
CONFIG_ALICE_SCRIPT_FILE=alice/scripts/demo.yaml

# 规则文件路径
CONFIG_ALICE_RULES_FILE=alice/scripts/rules/mapping.yaml

# =============================================================================
# Turing 配置覆盖
# =============================================================================

# 服务器端口
CONFIG_TURING_SERVER_PORT=8000

# 服务器地址
CONFIG_TURING_SERVER_HOST=0.0.0.0

# 匹配超时时间 (秒)
CONFIG_TURING_MATCH_TIMEOUT=30

# AI Bot 名称
CONFIG_TURING_AI_BOT_NAME=小图

# WebSocket 心跳间隔 (秒)
CONFIG_TURING_WEBSOCKET_PING_INTERVAL=20

# WebSocket 心跳超时 (秒)
CONFIG_TURING_WEBSOCKET_PING_TIMEOUT=30

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库 URL
CONFIG_TURING_DATABASE_URL=sqlite:///data/turing.db

# =============================================================================
# 认证配置
# =============================================================================

# JWT 密钥 (生产环境必须修改)
CONFIG_TURING_AUTH_SECRET_KEY=your-secret-key-change-in-production

# Token 过期时间 (分钟)
CONFIG_TURING_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================================================
# NLP 服务配置
# =============================================================================

# 启用 LTP (false 使用 jieba)
CONFIG_TURING_NLP_SERVICE_ENABLE_LTP=false

# NLP 缓存大小
CONFIG_TURING_NLP_SERVICE_CACHE_SIZE=1000

# NLP 缓存 TTL (秒)
CONFIG_TURING_NLP_SERVICE_CACHE_TTL=3600

# =============================================================================
# Bot 池配置
# =============================================================================

# 最小实例数
CONFIG_TURING_BOT_POOL_MIN_INSTANCES=2

# 最大实例数
CONFIG_TURING_BOT_POOL_MAX_INSTANCES=10

# 空闲超时 (秒)
CONFIG_TURING_BOT_POOL_IDLE_TIMEOUT=300
