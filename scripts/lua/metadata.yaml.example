# =============================================================================
# Lua 脚本元数据配置示例
# =============================================================================
# 说明：此文件用于定义 Lua 脚本的元数据配置
#       配置脚本优先级、变量等参数
# =============================================================================

scripts:
  # ---------------------------------------------------------------------------
  # 问候脚本
  # ---------------------------------------------------------------------------
  - name: greeting
    priority: 90                      # 优先级 (0-100)，越高越优先
    description: 问候脚本             # 脚本描述
    variables:                        # 传递给脚本的变量
      threshold: 0.8                  # 匹配阈值
      max_responses: 5                # 最大响应数
    enabled: true                     # 是否启用

  # ---------------------------------------------------------------------------
  # 实体分析脚本
  # ---------------------------------------------------------------------------
  - name: entity_analysis
    priority: 70
    description: 实体分析脚本
    variables:
      extract_person: true            # 提取人名
      extract_location: true          # 提取地点
      extract_time: true              # 提取时间
    enabled: true

  # ---------------------------------------------------------------------------
  # 对话流程脚本
  # ---------------------------------------------------------------------------
  - name: conversation_flow
    priority: 60
    description: 对话流程控制脚本
    variables:
      min_turns: 3                    # 最小对话轮数
      max_turns: 20                   # 最大对话轮数
    enabled: true

  # ---------------------------------------------------------------------------
  # 情感分析脚本 (示例)
  # ---------------------------------------------------------------------------
  - name: sentiment_analysis
    priority: 50
    description: 情感分析脚本
    variables:
      detect_positive: true
      detect_negative: true
      detect_neutral: true
    enabled: false                    # 默认禁用
