# =============================================================================
# Alice 模块配置 (示例)
# =============================================================================
# 说明：此文件包含 Alice 模块的所有配置项
#
# 使用方法:
# 1. 复制此文件为 config.alice.yaml
# 2. 根据实际情况修改配置项
# =============================================================================

# -----------------------------------------------------------------------------
# 功能开关
# -----------------------------------------------------------------------------
enable_ltp: true                      # 启用 LTP 句法分析
enable_ner: true                      # 启用 NER 实体识别
enable_log: true                      # 启用对话日志
enable_lua_engine: true               # 启用 Lua 脚本引擎 (新增)
ner_use_ltp: true                     # NER 使用 LTP 增强
hot_reload: true                      # 启用热重载
hot_reload_mode: auto                 # 热重载模式 (auto/manual)
hot_reload_poll_interval: 2.0         # 热重载轮询间隔 (秒)

# -----------------------------------------------------------------------------
# 文件路径 (相对于 project_root)
# -----------------------------------------------------------------------------
script_file: alice/scripts/demo.yaml
rules_file: alice/scripts/rules/mapping.yaml
semantic_tags_file: alice/scripts/semantic_tags.yaml
lua_script_dir: scripts/lua           # Lua 脚本目录 (新增)

# -----------------------------------------------------------------------------
# 对话上下文配置
# -----------------------------------------------------------------------------
context_max_items: 10
conversation_history_max_turns: 20
ltp_cache_size_limit: 100
dialogue_log_max_entries: 1000

# -----------------------------------------------------------------------------
# 性能配置
# -----------------------------------------------------------------------------
performance_monitor_sample_rate: 1.0
max_input_length: 500
script_match_timeout: 100             # 毫秒
regex_cache_size: 100

# -----------------------------------------------------------------------------
# Lua 脚本引擎配置 (新增)
# -----------------------------------------------------------------------------
lua_cache_size: 100                   # Lua 脚本缓存大小
lua_execution_timeout: 1.0            # Lua 脚本执行超时 (秒)
lua_sandbox_enabled: true            # 是否启用 Lua 沙箱

# -----------------------------------------------------------------------------
# 预定义响应
# -----------------------------------------------------------------------------
fallback_responses:
  - "嗯，我明白了。这里是默认回答。"
greeting_responses:
  - "你好！这里是默认回答"

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
log_max_size_mb: 10
log_backup_count: 5

# -----------------------------------------------------------------------------
# LTP 引擎配置 (共享)
# -----------------------------------------------------------------------------
ltp:
  enable_cws: true                    # 词分词
  enable_pos: true                    # 词性标注
  enable_ner: true                    # 命名实体识别
  enable_dep: true                    # 依存句法分析
  enable_sdp: true                    # 语义依存分析
  enable_srl: true                    # 语义角色标注
  cache_size: 50
  max_length: 512
