# =============================================================================
# Alice - 主配置文件 (示例)
# =============================================================================
# 配置说明:
# - 所有配置项必须显式定义，无代码硬编码默认值
# - 环境变量 (.env) 可覆盖此文件配置
# - 模块专属配置：config.alice.yaml, config.turing.yaml
#
# 使用方法:
# 1. 复制此文件为 config.yaml
# 2. 根据实际情况修改配置项
# 3. 确保 config.alice.yaml 和 config.turing.yaml 也存在
# =============================================================================

# -----------------------------------------------------------------------------
# 通用配置
# -----------------------------------------------------------------------------
debug: false
log_level: INFO

# -----------------------------------------------------------------------------
# 路径配置
# -----------------------------------------------------------------------------
paths:
  project_root: .                       # 项目根目录
  alice_dir: alice                      # Alice 模块目录
  turing_dir: turing_test               # Turing 测试模块目录
  log_dir: logs                         # 日志目录
  data_dir: data                        # 数据目录
  bots_dir: bots                        # Bot 配置目录

# -----------------------------------------------------------------------------
# 模块引用配置
# -----------------------------------------------------------------------------
modules:
  alice:
    config_file: config.alice.yaml      # Alice 专属配置文件
  turing:
    config_file: config.turing.yaml     # Turing 专属配置文件
    bot_pool:
      config_dir: bots                  # Bot 配置目录
      default_template: default         # 默认 Bot 模板 ID

# -----------------------------------------------------------------------------
# Sentry 错误追踪配置（可选）
# -----------------------------------------------------------------------------
# 生产环境建议配置 Sentry 进行错误监控
# DSN 获取方式：在 Sentry.io 创建项目后获取
# 也可通过环境变量设置：SENTRY_DSN=your-dsn
# -----------------------------------------------------------------------------
# sentry_dsn: "https://your-dsn@sentry.io/your-project-id"
# sentry_enabled: false
# environment: "production"
